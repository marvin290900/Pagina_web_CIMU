---
const user = Astro.locals.user;
import { ROLE_LABELS } from '../../lib/security/roles.js';
---
<section class="max-w-4xl mx-auto p-6 space-y-5"><h1 class="text-3xl font-bold">Bienvenido, {user.name}</h1><p>Abre el menú para acceder a tus módulos.</p><h2 class="text-xl font-bold">Tus accesos</h2><ul>{user.assignments.map(a => <li class="border rounded p-4 mb-2"><strong>{ROLE_LABELS[a.role]}</strong><p>{a.modules.join(', ')}</p>{a.modules.includes('gaceta') && <p>Secciones: {a.sections.includes('*') ? 'Todas' : a.sections.join(', ')}</p>}</li>)}</ul></section>
