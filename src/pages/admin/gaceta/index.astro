---
import Layout from '../../../layouts/Layout_admin.astro';
import { can } from '../../../lib/security/roles.js';
const user = Astro.locals.user;
---
<Layout><section class="max-w-4xl mx-auto px-4 space-y-6"><h1 class="text-3xl font-bold">Gaceta Multidisciplinaria</h1>
<div class="flex flex-wrap gap-4">
<a class="btn btn-primary" href="/admin/gaceta/gestion_publicaciones">Publicaciones y revisión</a>
{can(user, 'autores.manage') && <a class="btn" href="/admin/gaceta/gestion_autores">Autores públicos</a>}
{can(user, 'gaceta.feature') && <a class="btn" href="/admin/gaceta/gestion_destacados">Destacados</a>}
</div></section></Layout>
