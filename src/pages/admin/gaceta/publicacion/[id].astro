---
import LayoutAdmin from '../../../../layouts/Layout_admin.astro';
import DetallePublicacion from '../../../../components/componentes_admin/gaceta/gestion_publicaciones/DetallePublicacion.vue';
import { getNews } from '../../../../lib/security/newsStore.js';
import { sectionSchema, assertNewsRead, publicAuthor } from '../../../../lib/security/editorial.js';
import { idSchema } from '../../../../lib/security/validation.js';
import { errorResponse } from '../../../../lib/security/http.js';

let publication, author, section;
try {
  section = sectionSchema.parse(Astro.url.searchParams.get('categoria'));
  const doc = await getNews(section, idSchema.parse(Astro.params.id));
  assertNewsRead(Astro.locals.user, doc, section);
  publication = doc;
  author = { nombre: doc.autor?.nombre || 'Autor', foto: '' };
  if (doc.autor?.id) {
    try { author = publicAuthor(await getNews('autores', doc.autor.id)); }
    catch (error) { if (error.response?.status !== 404) throw error; }
  }
} catch (error) { return errorResponse(error); }
---
<LayoutAdmin>
  <DetallePublicacion initialPublication={publication} user={Astro.locals.user} section={section} author={author} client:load />
</LayoutAdmin>
