---
import Layout from '../../layouts/Layout_admin.astro';
const user = Astro.locals.user;
---
<Layout><section class="max-w-xl mx-auto p-6 space-y-5">
  <h1 class="text-3xl font-bold">Mi cuenta</h1><p>{user.name} · {user.email}</p>
  <h2 class="text-xl font-bold">Cambiar contraseña</h2>
  <form id="password-form" class="space-y-4">
    <label class="block">Contraseña actual<input name="currentPassword" class="input block w-full" type="password" required autocomplete="current-password" /></label>
    <label class="block">Nueva contraseña<input name="password" class="input block w-full" type="password" required minlength="12" autocomplete="new-password" /></label>
    <label class="block">Repetir nueva contraseña<input name="confirmation" class="input block w-full" type="password" required minlength="12" autocomplete="new-password" /></label>
    <button class="btn btn-primary">Cambiar y cerrar sesiones</button>
  </form><p id="password-message" role="status"></p>
</section></Layout>
<script>
  document.querySelector<HTMLFormElement>('#password-form')!.addEventListener('submit', async event => {
    event.preventDefault(); const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form), message = document.querySelector('#password-message')!;
    if (data.get('password') !== data.get('confirmation')) { message.textContent = 'Las contraseñas no coinciden'; return; }
    const button = form.querySelector('button')!; button.disabled = true;
    try {
      const response = await fetch('/api/cuenta/password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ currentPassword: data.get('currentPassword'), password: data.get('password') }) });
      const result = await response.json();
      if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'Revisa los datos');
      location.href = '/login';
    } catch (error) { message.textContent = error instanceof Error ? error.message : 'No se pudo cambiar'; }
    finally { button.disabled = false; }
  });
</script>
