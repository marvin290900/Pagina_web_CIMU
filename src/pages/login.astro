---
import Layout from '../layouts/Layout_login.astro';
import AccesoCuenta from '../components/auth/AccesoCuenta.vue';
import { safeRedirect } from '../lib/security/http.js';
if (Astro.locals.user) return Astro.redirect('/admin', 302);
const redirectTo = safeRedirect(Astro.url.searchParams.get('redirect'));
---
<Layout title="Iniciar sesión"><AccesoCuenta redirectTo={redirectTo} client:load /></Layout>
