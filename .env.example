# Copia este archivo a .env y completa ambas contraseñas antes del primer arranque.
# La cuenta de CouchDB y la cuenta del panel son distintas.
COUCHDB_USER=cimu_service
COUCHDB_PASSWORD=cimu_service
COUCHDB_PORT=5985
CIMU_HTTP_PORT=8081

CIMU_ADMIN_EMAIL=admin@cimu.ues
CIMU_ADMIN_NAME='Administración CIMU'
# Al menos 12 caracteres y como máximo 72 bytes UTF-8; utiliza una contraseña propia.
CIMU_ADMIN_PASSWORD=123456789012
# true carga contenido ficticio SOLO en la primera instalación. false deja el catálogo vacío.
CIMU_SEED_DEMO=true

# Para ejecutar scripts sin Docker. Compose sustituye esta URL por http://couchdb:5984.
COUCHDB_URL=http://127.0.0.1:5985
# true prepara instalaciones nuevas antes de abrir el servidor.
# Tras preparar el entorno, false permite arrancar sin ejecutar la inicialización.
CIMU_BOOTSTRAP=true
